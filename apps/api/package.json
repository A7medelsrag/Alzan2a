{
  "name": "@store/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "predev": "pnpm --filter @store/shared build",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "pretypecheck": "pnpm --filter @store/shared build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "admin:create-owner": "pnpm build && node dist/cli/create-owner.js"
  },
  "prisma": {
    "seed": "node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "@prisma/client": "6.19.3",
    "@store/shared": "workspace:*",
    "argon2": "^0.45.2",
    "fastify": "^5.2.1",
    "google-auth-library": "^11.3.3",
    "prisma": "6.19.3",
    "redis": "^6.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
