# Database (PostgreSQL)
POSTGRES_USER=zan2a
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=zan2a_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://zan2a:replace-with-a-local-development-password@localhost:5432/zan2a_dev?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ADMIN_MFA_ENCRYPTION_KEY=
# Optional dedicated HMAC secret (>= 32 chars) for guest order receipt tokens; derived from ADMIN_MFA_ENCRYPTION_KEY if omitted.
ORDER_RECEIPT_SECRET=

# API
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
API_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# Set to true, hop count (e.g. 1), or trusted proxy IPs/CIDRs when behind a reverse proxy.
TRUST_PROXY=false
# Comma-separated origins. Required in production.
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Media storage (local is for development only; production requires S3-compatible storage)
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_DIRECTORY=.media
# Use the HTTPS URL exposed by a local TLS proxy in development.
MEDIA_PUBLIC_ASSET_BASE_URL=https://localhost:4000/api/v1/media
# S3-compatible settings are required when MEDIA_STORAGE_DRIVER=s3.
# MEDIA_S3_ENDPOINT=https://s3.example.com
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_BUCKET=zan2a-assets
# MEDIA_S3_ACCESS_KEY_ID=replace-with-server-side-access-key
# MEDIA_S3_SECRET_ACCESS_KEY=replace-with-server-side-secret
MEDIA_S3_FORCE_PATH_STYLE=true

# Optional S3/CDN integration test. Use a dedicated test bucket and credentials only.
# MEDIA_S3_INTEGRATION_ENABLED=true
# MEDIA_S3_INTEGRATION_ALLOW_TEST_BUCKET_WRITES=true
# MEDIA_S3_INTEGRATION_ENDPOINT=https://s3-test.example.net
# MEDIA_S3_INTEGRATION_REGION=us-east-1
# MEDIA_S3_INTEGRATION_BUCKET=zan2a-assets-test
# MEDIA_S3_INTEGRATION_ACCESS_KEY_ID=replace-with-test-only-access-key
# MEDIA_S3_INTEGRATION_SECRET_ACCESS_KEY=replace-with-test-only-secret
# MEDIA_S3_INTEGRATION_FORCE_PATH_STYLE=true
# MEDIA_S3_INTEGRATION_CDN_BASE_URL=https://cdn-test.example.net/media
